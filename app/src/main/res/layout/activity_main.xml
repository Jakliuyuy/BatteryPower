<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipToPadding="false">

        <!-- ==================== 运行状态 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_status"
                    style="@style/BpSectionTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/grant_overlay" />

                    <Button
                        android:id="@+id/btnGrantNotify"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/grant_notify" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRestartSystemUi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/restart_systemui" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textIsSelectable="true"
                    android:typeface="monospace"
                    android:textSize="11sp"
                    android:text="@string/status_placeholder" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 悬浮窗 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_enable" />

                <!-- 显示项 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_fields"
                    style="@style/BpSectionTitle" />

                <LinearLayout
                    android:id="@+id/overlayFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp" />

                <!-- 颜色 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_color"
                    style="@style/BpSectionTitle" />

                <com.jakliuyuy.batterypower.ui.HsvColorPickerView
                    android:id="@+id/pickerOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/overlayPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 字号 -->
                <TextView
                    android:id="@+id/tvOverlaySize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_text_size"
                    style="@style/BpSectionTitle" />

                <SeekBar
                    android:id="@+id/sbOverlaySize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20" />

                <!-- 刷新频率 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_interval"
                    style="@style/BpSectionTitle" />

                <RadioGroup
                    android:id="@+id/rgOverlayInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbOverlay500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_500" />

                    <RadioButton
                        android:id="@+id/rbOverlay1000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_1000" />

                    <RadioButton
                        android:id="@+id/rbOverlay2000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_2000" />
                </RadioGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swOverlayUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_show_unit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 状态栏 Hook ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sb_enable" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sb_hint"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_fields"
                    style="@style/BpSectionTitle" />

                <LinearLayout
                    android:id="@+id/sbFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_color"
                    style="@style/BpSectionTitle" />

                <com.jakliuyuy.batterypower.ui.HsvColorPickerView
                    android:id="@+id/pickerSb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/sbPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvSbSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_text_size"
                    style="@style/BpSectionTitle" />

                <SeekBar
                    android:id="@+id/sbSbSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_interval"
                    style="@style/BpSectionTitle" />

                <RadioGroup
                    android:id="@+id/rgSbInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSb500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_500" />

                    <RadioButton
                        android:id="@+id/rbSb1000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_1000" />

                    <RadioButton
                        android:id="@+id/rbSb2000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_2000" />

                    <RadioButton
                        android:id="@+id/rbSb3000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_3000" />

                    <RadioButton
                        android:id="@+id/rbSb5000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/interval_5000" />
                </RadioGroup>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swSbUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_show_unit" />

                <!-- 位置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_position"
                    style="@style/BpSectionTitle" />

                <RadioGroup
                    android:id="@+id/rgSbPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbPosLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pos_clock_left" />

                    <RadioButton
                        android:id="@+id/rbPosRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pos_clock_right" />
                </RadioGroup>

                <!-- 水平偏移 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvOffsetX"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="@string/offset_x" />

                    <ImageButton
                        android:id="@+id/btnOffsetXMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/step_minus"
                        android:src="@android:drawable/ic_media_previous"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <SeekBar
                        android:id="@+id/sbOffsetX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="4000" />

                    <ImageButton
                        android:id="@+id/btnOffsetXPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/step_plus"
                        android:src="@android:drawable/ic_media_next"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- 垂直偏移 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvOffsetY"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:text="@string/offset_y" />

                    <ImageButton
                        android:id="@+id/btnOffsetYMinus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/step_minus"
                        android:src="@android:drawable/ic_media_previous"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <SeekBar
                        android:id="@+id/sbOffsetY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="2000" />

                    <ImageButton
                        android:id="@+id/btnOffsetYPlus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/step_plus"
                        android:src="@android:drawable/ic_media_next"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 诊断 ==================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_diagnose"
                    style="@style/BpSectionTitle" />

                <Button
                    android:id="@+id/btnDiagnose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/run_diagnose" />

                <TextView
                    android:id="@+id/tvDiagnose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textIsSelectable="true"
                    android:typeface="monospace"
                    android:textSize="11sp"
                    android:text="@string/diagnose_placeholder" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
